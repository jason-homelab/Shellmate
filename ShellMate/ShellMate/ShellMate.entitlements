<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- App Sandbox：App Store 强制要求 -->
    <key>com.apple.security.app-sandbox</key>
    <true/>

    <!-- 网络：作为客户端发起 SSH 连接 -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- 网络：作为服务端监听本地端口（本地端口转发 -L）-->
    <key>com.apple.security.network.server</key>
    <true/>

    <!-- 文件访问：用户主动选择的文件（私钥文件选取）-->
    <key>com.apple.security.files.user-selected.read-only</key>
    <true/>

    <!--
    ========= 生产环境需额外添加（需要正式 Provisioning Profile）=========

    iCloud / CloudKit 同步：
    <key>com.apple.security.application-groups</key>
    <array>
        <string>$(TeamIdentifierPrefix)app.shellmate</string>
    </array>
    <key>com.apple.developer.icloud-services</key>
    <array>
        <string>CloudKit</string>
    </array>
    <key>com.apple.developer.icloud-container-identifiers</key>
    <array>
        <string>iCloud.app.shellmate</string>
    </array>

    Keychain 访问组：
    <key>keychain-access-groups</key>
    <array>
        <string>$(AppIdentifierPrefix)app.shellmate</string>
    </array>
    ========= 生产环境需额外添加 END =========
    -->
</dict>
</plist>
